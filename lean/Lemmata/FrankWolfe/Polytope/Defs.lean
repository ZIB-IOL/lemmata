module

public import Mathlib.Analysis.Convex.Hull
public import Mathlib.Analysis.Normed.Module.Basic
public import Mathlib.Topology.Algebra.Module.Spaces.ContinuousLinearMap

@[expose] public section

/-!
# Polytopes: definitions

The cone generated by a finite set, the exposed faces of the convex hull of a finite set, and the
minimal face of a point.
-/

namespace Lemmata.FrankWolfe

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The cone generated by a finite set `G`: all nonnegative combinations `∑ c_g g`. -/
def coneHull (G : Finset E) : Set E :=
  {x | ∃ c : E → ℝ, (∀ g ∈ G, 0 ≤ c g) ∧ x = ∑ g ∈ G, c g • g}

open Classical in
/-- The vertices of `V` maximizing `ψ`: the vertex set of an exposed face of `conv V`. -/
noncomputable def exposedFace (V : Finset E) (ψ : StrongDual ℝ E) : Finset E :=
  V.filter (fun w => ∀ u ∈ V, ψ u ≤ ψ w)

open Classical in
/-- The minimal face of `y`: the vertices of `V` lying in every exposed face whose functional is
maximized over `V` at `y`. -/
noncomputable def minFace (V : Finset E) (y : E) : Finset E :=
  V.filter (fun w => ∀ ψ : StrongDual ℝ E, (∀ u ∈ V, ψ u ≤ ψ y) → ∀ u ∈ V, ψ u ≤ ψ w)

end Lemmata.FrankWolfe
