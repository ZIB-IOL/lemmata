module

public import Lemmata.FrankWolfe.Polytope.Defs
public import Mathlib.Analysis.LocallyConvex.Separation
public import Mathlib.Topology.Algebra.Module.FiniteDimension
public import Mathlib.LinearAlgebra.LinearIndependent.Defs
public import Mathlib.Analysis.Convex.Basic

@[expose] public section

/-!
# Finitely generated cones and the Farkas lemma

The cone generated by a finite set `G` in a real normed space is the set of nonnegative combinations
of its elements. In finite dimensions it is closed, and the Farkas lemma separates a point outside
it by a functional that is nonpositive on `G`.
-/

namespace Lemmata.FrankWolfe

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem zero_mem_coneHull (G : Finset E) : (0 : E) ∈ coneHull G :=
  ⟨fun _ => 0, fun _ _ => le_rfl, by simp⟩

theorem smul_mem_coneHull {G : Finset E} {x : E} (hx : x ∈ coneHull G) {s : ℝ} (hs : 0 ≤ s) :
    s • x ∈ coneHull G := by
  obtain ⟨c, hc, rfl⟩ := hx
  exact ⟨fun g => s * c g, fun g hg => mul_nonneg hs (hc g hg), by
    rw [Finset.smul_sum]; simp [mul_smul]⟩

theorem add_mem_coneHull {G : Finset E} {x y : E} (hx : x ∈ coneHull G) (hy : y ∈ coneHull G) :
    x + y ∈ coneHull G := by
  obtain ⟨c, hc, rfl⟩ := hx
  obtain ⟨d, hd, rfl⟩ := hy
  exact ⟨fun g => c g + d g, fun g hg => add_nonneg (hc g hg) (hd g hg), by
    rw [← Finset.sum_add_distrib]; simp [add_smul]⟩

theorem convex_coneHull (G : Finset E) : Convex ℝ (coneHull G) := by
  intro x hx y hy a b ha hb _
  exact add_mem_coneHull (smul_mem_coneHull hx ha) (smul_mem_coneHull hy hb)

theorem subset_coneHull (G : Finset E) : (↑G : Set E) ⊆ coneHull G := by
  classical
  intro g hg
  refine ⟨fun h => if h = g then 1 else 0, fun h _ => by dsimp only; split_ifs <;> norm_num, ?_⟩
  simp only [ite_smul, one_smul, zero_smul, Finset.sum_ite_eq', Finset.mem_coe.mp hg, ite_true]

/-- Conic Carathéodory: every point of the cone generated by `G` lies in the cone generated by a
linearly independent subset of `G`. -/
theorem exists_linearIndependent_of_mem_coneHull {G : Finset E} {x : E} (hx : x ∈ coneHull G) :
    ∃ I ⊆ G, LinearIndependent ℝ (fun i : I => (i : E)) ∧ x ∈ coneHull I := by
  classical
  suffices h : ∀ n : ℕ, ∀ T ⊆ G, T.card = n → ∀ c : E → ℝ, (∀ g ∈ T, 0 < c g) →
      x = ∑ g ∈ T, c g • g →
      ∃ I ⊆ G, LinearIndependent ℝ (fun i : I => (i : E)) ∧ x ∈ coneHull I by
    obtain ⟨c, hc, hxc⟩ := hx
    refine h _ (G.filter (fun g => 0 < c g)) (Finset.filter_subset _ _) rfl c
      (fun g hg => (Finset.mem_filter.mp hg).2) ?_
    rw [hxc, Finset.sum_filter_of_ne]
    intro g hg hne
    rcases (hc g hg).lt_or_eq with h | h
    · exact h
    · exfalso; apply hne; rw [← h, zero_smul]
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro T hTG hTn c hc hxc
    by_cases hli : LinearIndependent ℝ (fun i : T => (i : E))
    · exact ⟨T, hTG, hli, c, fun g hg => (hc g hg).le, hxc⟩
    · obtain ⟨a, ha, i, hi⟩ := Fintype.not_linearIndependent_iff.mp hli
      set A : E → ℝ := fun g => if h : g ∈ T then a ⟨g, h⟩ else 0 with hAdef
      have hA0 : ∑ g ∈ T, A g • g = 0 := by
        rw [← ha, ← Finset.sum_coe_sort T]
        apply Finset.sum_congr rfl
        intro j _
        simp [A, j.2]
      obtain ⟨B, hB0, j, hjT, hj⟩ : ∃ B : E → ℝ, ∑ g ∈ T, B g • g = 0 ∧ ∃ j ∈ T, 0 < B j := by
        have hAi : A i ≠ 0 := by simp [A, i.2, hi]
        rcases lt_or_gt_of_ne hAi with hneg | hpos
        · refine ⟨fun g => -A g, ?_, i, i.2, by simp only; linarith⟩
          simp only [neg_smul, Finset.sum_neg_distrib, hA0, neg_zero]
        · exact ⟨A, hA0, i, i.2, hpos⟩
      set P := T.filter (fun g => 0 < B g) with hP
      have hPne : P.Nonempty := ⟨j, Finset.mem_filter.mpr ⟨hjT, hj⟩⟩
      obtain ⟨g0, hg0P, hg0min⟩ := P.exists_min_image (fun g => c g / B g) hPne
      have hg0 := Finset.mem_filter.mp hg0P
      set t := c g0 / B g0 with ht
      have ht0 : 0 ≤ t := div_nonneg (hc g0 hg0.1).le hg0.2.le
      set c' : E → ℝ := fun g => c g - t * B g with hc'
      have hc'nn : ∀ g ∈ T, 0 ≤ c' g := by
        intro g hg
        by_cases hBg : 0 < B g
        · have h1 := hg0min g (Finset.mem_filter.mpr ⟨hg, hBg⟩)
          have h2 : t * B g ≤ c g := by rw [← le_div_iff₀ hBg]; exact h1
          simp only [hc']; linarith
        · push Not at hBg
          have := mul_nonpos_of_nonneg_of_nonpos ht0 hBg
          simp only [hc']; linarith [hc g hg]
      have hc'0 : c' g0 = 0 := by
        have hBne : B g0 ≠ 0 := hg0.2.ne'
        simp only [hc', ht]
        rw [div_mul_cancel₀ _ hBne, sub_self]
      have hxc' : x = ∑ g ∈ T, c' g • g := by
        simp only [hc', sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hB0,
          smul_zero, sub_zero]
        exact hxc
      set T' := T.filter (fun g => 0 < c' g) with hT'
      have hT'card : T'.card < n := by
        rw [← hTn]
        apply Finset.card_lt_card
        refine ⟨Finset.filter_subset _ _, fun hsub => ?_⟩
        have := Finset.mem_filter.mp (hsub hg0.1)
        linarith [this.2]
      have hxT' : x = ∑ g ∈ T', c' g • g := by
        rw [hxc', Finset.sum_filter_of_ne]
        intro g hg hne
        rcases (hc'nn g hg).lt_or_eq with h | h
        · exact h
        · exfalso; apply hne; rw [← h, zero_smul]
      exact ih T'.card hT'card T' ((Finset.filter_subset _ _).trans hTG) rfl c'
        (fun g hg => (Finset.mem_filter.mp hg).2) hxT'

theorem coneHull_mono {I G : Finset E} (hIG : I ⊆ G) : coneHull I ⊆ coneHull G := by
  classical
  rintro x ⟨c, hc, rfl⟩
  refine ⟨fun g => if g ∈ I then c g else 0, fun g _ => ?_, ?_⟩
  · by_cases h : g ∈ I
    · simp only [h, ite_true]; exact hc g h
    · simp only [h, ite_false]; exact le_rfl
  · rw [← Finset.sum_subset hIG (fun g _ hg => by simp [hg])]
    exact Finset.sum_congr rfl (fun g hg => by simp [hg])

/-- In finite dimensions the cone generated by a finite set is closed. -/
theorem isClosed_coneHull [FiniteDimensional ℝ E] (G : Finset E) : IsClosed (coneHull G) := by
  classical
  have hunion : coneHull G = ⋃ I ∈ G.powerset.filter
      (fun I : Finset E => LinearIndependent ℝ (fun i : I => (i : E))), coneHull I := by
    ext x
    constructor
    · intro hx
      obtain ⟨I, hIG, hli, hxI⟩ := exists_linearIndependent_of_mem_coneHull hx
      exact Set.mem_iUnion₂.mpr ⟨I, Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hIG, hli⟩, hxI⟩
    · intro hx
      simp only [Set.mem_iUnion] at hx
      obtain ⟨I, hI, hxI⟩ := hx
      exact coneHull_mono (Finset.mem_powerset.mp (Finset.mem_filter.mp hI).1) hxI
  rw [hunion]
  refine isClosed_biUnion_finset (fun I hI => ?_)
  have hli := (Finset.mem_filter.mp hI).2
  let L : (I → ℝ) →ₗ[ℝ] E := Fintype.linearCombination ℝ (fun i : I => (i : E))
  have hker : LinearMap.ker L = ⊥ := by
    refine LinearMap.ker_eq_bot'.mpr (fun c hc => funext fun i => ?_)
    exact Fintype.linearIndependent_iff.mp hli c (by rwa [Fintype.linearCombination_apply] at hc) i
  have hemb := LinearMap.isClosedEmbedding_of_injective hker
  have horth : IsClosed {c : I → ℝ | ∀ i, 0 ≤ c i} := by
    simp only [Set.ofPred_forall]
    exact isClosed_iInter (fun i => isClosed_le continuous_const (continuous_apply i))
  have himg : coneHull I = L '' {c : I → ℝ | ∀ i, 0 ≤ c i} := by
    ext x
    constructor
    · rintro ⟨c, hc, rfl⟩
      refine ⟨fun i => c i, fun i => hc i i.2, ?_⟩
      simp only [L, Fintype.linearCombination_apply]
      exact Finset.sum_coe_sort I (fun g => c g • g)
    · rintro ⟨c, hc, rfl⟩
      refine ⟨fun g => if h : g ∈ I then c ⟨g, h⟩ else 0, fun g hg => by
        simp only [hg, dite_true]; exact hc _, ?_⟩
      simp only [L, Fintype.linearCombination_apply]
      rw [← Finset.sum_coe_sort I]
      exact Finset.sum_congr rfl (fun i _ => by simp [i.2])
  rw [himg]
  exact hemb.isClosedMap _ horth

/-- **Farkas lemma.** In finite dimensions, a point outside the cone generated by a finite set `G`
is separated from it by a functional that is nonpositive on `G` and positive at the point. -/
theorem farkas [FiniteDimensional ℝ E] (G : Finset E) {x : E} (hx : x ∉ coneHull G) :
    ∃ ψ : StrongDual ℝ E, (∀ g ∈ G, ψ g ≤ 0) ∧ 0 < ψ x := by
  obtain ⟨f, u, hfx, hf⟩ :=
    geometric_hahn_banach_point_closed (convex_coneHull G) (isClosed_coneHull G) hx
  have hu : u < 0 := by simpa using hf 0 (zero_mem_coneHull G)
  have hnn : ∀ b ∈ coneHull G, 0 ≤ f b := by
    intro b hb
    by_contra hneg
    push Not at hneg
    have hs : 0 < u / f b := div_pos_of_neg_of_neg hu hneg
    have := hf ((u / f b) • b) (smul_mem_coneHull hb hs.le)
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hneg.ne] at this
    linarith
  refine ⟨-f, fun g hg => ?_, ?_⟩
  · show -(f g) ≤ 0
    linarith [hnn g (subset_coneHull G hg)]
  · show 0 < -(f x)
    linarith

end Lemmata.FrankWolfe
