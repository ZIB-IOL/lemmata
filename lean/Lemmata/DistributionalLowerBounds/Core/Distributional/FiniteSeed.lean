module

public import Lemmata.DistributionalLowerBounds.Core.Distributional.AdaptiveEndToEnd

@[expose] public section

/-!
# Finite-support randomization

This module formalizes the last averaging step for a randomized method with a
finite seed type.  For each fixed seed, the method must already be represented
by an `AdaptiveTranscriptProcess` satisfying the final-deficit and
conditional-loss hypotheses of `adaptive_distributional_lower_bound`.
The theorem below applies that deterministic result seed by seed and averages
it with an arbitrary finite probability mass function on seeds.

This module itself does *not* construct an `AdaptiveTranscriptProcess` from
transcript-to-query functions.  `FiniteStrategy.lean`, which imports this
module, constructs the reachable-history laws and the process once explicit
per-history hard-family certificates are supplied.
-/

namespace Lemmata.DistributionalLowerBounds.Core.Distributional

namespace FinitePMF

variable {Seed Omega : Type*} [Fintype Seed] [Fintype Omega]

/-- The product of two finite probability mass functions. -/
noncomputable def product (seedLaw : FinitePMF Seed) (instanceLaw : FinitePMF Omega) :
    FinitePMF (Seed × Omega) where
  weight pair := seedLaw.weight pair.1 * instanceLaw.weight pair.2
  nonneg pair := mul_nonneg (seedLaw.nonneg pair.1) (instanceLaw.nonneg pair.2)
  sum_weight := by
    rw [show (∑ pair : Seed × Omega,
        seedLaw.weight pair.1 * instanceLaw.weight pair.2) =
        ∑ seed : Seed, ∑ omega : Omega,
          seedLaw.weight seed * instanceLaw.weight omega by
      simp only [Fintype.sum_prod_type]]
    simp_rw [← Finset.mul_sum, instanceLaw.sum_weight, mul_one]
    exact seedLaw.sum_weight

/-- Expectation under the product law is iterated expectation, with the seed
on the outside and the hidden instance on the inside. -/
theorem product_expect (seedLaw : FinitePMF Seed) (instanceLaw : FinitePMF Omega)
    (X : Seed × Omega → ℝ) :
    (seedLaw.product instanceLaw).expect X =
      seedLaw.expect (fun seed => instanceLaw.expect (fun omega => X (seed, omega))) := by
  simp only [expect, product]
  rw [show (∑ pair : Seed × Omega,
      (seedLaw.weight pair.1 * instanceLaw.weight pair.2) * X pair) =
      ∑ seed : Seed, ∑ omega : Omega,
        (seedLaw.weight seed * instanceLaw.weight omega) * X (seed, omega) by
    simp only [Fintype.sum_prod_type]]
  apply Finset.sum_congr rfl
  intro seed _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro omega _
  ring

/-- A lower bound valid after conditioning on every seed remains valid after
averaging over any finite seed law. -/
theorem expect_seedwise_ge (seedLaw : FinitePMF Seed)
    (risk : Seed → ℝ) {lower : ℝ} (h : ∀ seed, lower ≤ risk seed) :
    lower ≤ seedLaw.expect risk :=
  seedLaw.expect_ge_of_pointwise h

end FinitePMF

/-- Finite-support randomized version of
`adaptive_distributional_lower_bound`.

For every fixed seed, `process seed` is the certified adaptive transcript
process generated by the corresponding deterministic method.  The conclusion
is the joint expected loss under the independent finite seed and instance
laws. -/
theorem finiteSeed_adaptive_distributional_lower_bound
    {Seed Omega : Type*} [Fintype Seed] [Fintype Omega]
    (seedLaw : FinitePMF Seed) (instanceLaw : FinitePMF Omega)
    (Delta loss : Seed → Omega → ℝ)
    (T : ℕ)
    (process : Seed → AdaptiveTranscriptProcess (proofDimension T) T)
    {rho : ℝ}
    (hrhoIoo : rho ∈ Set.Ioo (0 : ℝ) 1)
    (hrhoEq :
      rhoLHS (hardWeight (proofDimension T))
          (hardTopWeight (proofDimension T)) rho =
        hardC (proofDimension T) ^ 2)
    (hzero : ∀ seed,
      (process seed).meanDeficit 0 = initialDeficit (proofDimension T))
    (hfinal : ∀ seed,
      (process seed).meanDeficit T = instanceLaw.expect (Delta seed))
    (hloss : ∀ seed omega,
      rho ^ 2 * hardC (proofDimension T) ^ 2 * Delta seed omega ^ 2 /
          (48 * (proofDimension T : ℝ) ^ 2) ≤ loss seed omega) :
    hardC (proofDimension T) ^ 2 /
        (768 * (proofDimension T : ℝ) ^ 2) ≤
      (seedLaw.product instanceLaw).expect (fun pair => loss pair.1 pair.2) := by
  rw [seedLaw.product_expect instanceLaw]
  apply seedLaw.expect_seedwise_ge
  intro seed
  exact adaptive_distributional_lower_bound instanceLaw (Delta seed) (loss seed)
    T (process seed) hrhoIoo hrhoEq (hzero seed) (hfinal seed) (hloss seed)

end Lemmata.DistributionalLowerBounds.Core.Distributional
