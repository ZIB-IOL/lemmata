module

public import Lemmata.DistributionalLowerBounds.Core.Distributional.FiniteSeed

@[expose] public section

/-!
# Finite-instance adaptive strategies and induced transcript processes

This module gives a concrete meaning to an adaptive deterministic method.  A
strategy maps its previous answer list to the next query and maps the final
answer list to an output.  A deterministic oracle and hidden instance then
induce the transcript recursively.

Because the hidden instance type is finite, the set of transcripts reachable
at any fixed depth is finite even when the query and answer types themselves
are infinite.  We push the fixed instance PMF onto that reachable-history set.
Given, at each reachable history, the hard-family `HistoryNode` and the exact
conditional deficit-drop identity, `CertifiedStrategy.toAdaptiveProcess`
constructs the `AdaptiveTranscriptProcess` required by the existing end-to-end
theorem.

The remaining hard-family task is explicit: construct the `HistoryNode` and
prove `drop_identity` from the exact real LMO transcript.  It is not hidden in
this module.
-/

namespace Lemmata.DistributionalLowerBounds.Core.Distributional

namespace FinitePMF

variable {A B : Type*} [Fintype A] [Fintype B]

/-- Push a finite PMF through a deterministic map. -/
noncomputable def map (P : FinitePMF A) (f : A → B) : FinitePMF B := by
  classical
  refine
    { weight := fun b => ∑ a, if f a = b then P.weight a else 0
      nonneg := ?_
      sum_weight := ?_ }
  · intro b
    apply Finset.sum_nonneg
    intro a _
    by_cases h : f a = b
    · simpa [h] using P.nonneg a
    · simp [h]
  · calc
      (∑ b, ∑ a, if f a = b then P.weight a else 0) =
          ∑ a, ∑ b, if f a = b then P.weight a else 0 := Finset.sum_comm
      _ = ∑ a, P.weight a := by
        apply Finset.sum_congr rfl
        intro a _
        simp
      _ = 1 := P.sum_weight

/-- Unnormalized contribution of one fiber to the expectation of `X`. -/
noncomputable def fiberContribution (P : FinitePMF A) (f : A → B)
    (X : A → ℝ) (b : B) : ℝ := by
  classical
  exact ∑ a, if f a = b then P.weight a * X a else 0

/-- Summing all fiber contributions recovers the original expectation. -/
theorem sum_fiberContribution (P : FinitePMF A) (f : A → B) (X : A → ℝ) :
    ∑ b, P.fiberContribution f X b = P.expect X := by
  classical
  unfold fiberContribution expect
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  simp

/-- The expectation of a statistic after pushforward equals its expectation
before pushforward. -/
theorem map_expect (P : FinitePMF A) (f : A → B) (X : B → ℝ) :
    (P.map f).expect X = P.expect (fun a => X (f a)) := by
  classical
  change (∑ b, (∑ a, if f a = b then P.weight a else 0) * X b) =
    ∑ a, P.weight a * X (f a)
  rw [show (∑ b, (∑ a, if f a = b then P.weight a else 0) * X b) =
      ∑ b, ∑ a, if f a = b then P.weight a * X b else 0 by
    apply Finset.sum_congr rfl
    intro b _
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro a _
    by_cases h : f a = b <;> simp [h]]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  simp

/-- Expectation is linear under subtraction. -/
theorem expect_sub (P : FinitePMF A) (X Y : A → ℝ) :
    P.expect (fun a => X a - Y a) = P.expect X - P.expect Y := by
  unfold expect
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro a _
  ring

end FinitePMF

/-- A deterministic adaptive strategy.  The answer list contains the complete
information returned by all earlier first-order and LMO queries. -/
structure DeterministicAdaptiveStrategy (Query Answer Output : Type) where
  nextQuery : ℕ → List Answer → Query
  output : List Answer → Output

namespace DeterministicAdaptiveStrategy

variable {Query Answer Output Omega : Type}

/-- Transcript generated by a deterministic strategy against a deterministic
instance-indexed oracle. -/
def transcript (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer) (omega : Omega) : ℕ → List Answer
  | 0 => []
  | t + 1 =>
      let history := transcript strategy oracle omega t
      history ++ [oracle omega (strategy.nextQuery t history)]

@[simp] theorem transcript_zero
    (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer) (omega : Omega) :
    strategy.transcript oracle omega 0 = [] := rfl

@[simp] theorem transcript_succ
    (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer) (omega : Omega) (t : ℕ) :
    strategy.transcript oracle omega (t + 1) =
      strategy.transcript oracle omega t ++
        [oracle omega
          (strategy.nextQuery t (strategy.transcript oracle omega t))] := rfl

@[simp] theorem transcript_length
    (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer) (omega : Omega) (t : ℕ) :
    (strategy.transcript oracle omega t).length = t := by
  induction t with
  | zero => rfl
  | succ t ih => simp [transcript, ih]

/-- Final output after `T` oracle calls. -/
def run (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer) (omega : Omega) (T : ℕ) : Output :=
  strategy.output (strategy.transcript oracle omega T)

end DeterministicAdaptiveStrategy

section ReachableHistories

variable {Query Answer Output Omega : Type} [Fintype Omega]
    (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer)

/-- Histories actually reached by at least one hidden instance after `t`
queries.  This type is finite because `Omega` is finite; `Answer` need not be. -/
def ReachableHistory (t : ℕ) :=
  Set.range (fun omega => strategy.transcript oracle omega t)

/-- The reachable-history point generated by one hidden instance. -/
def reachableHistoryOf (t : ℕ) (omega : Omega) :
    ReachableHistory strategy oracle t :=
  ⟨strategy.transcript oracle omega t, ⟨omega, rfl⟩⟩

noncomputable instance reachableHistoryFintype (t : ℕ) :
    Fintype (ReachableHistory strategy oracle t) := by
  classical
  apply Fintype.ofSurjective (reachableHistoryOf strategy oracle t)
  rintro ⟨history, omega, rfl⟩
  exact ⟨omega, rfl⟩

/-- Push the fixed instance prior onto the finite set of reachable histories. -/
noncomputable def reachableHistoryLaw (instanceLaw : FinitePMF Omega) (t : ℕ) :
    FinitePMF (ReachableHistory strategy oracle t) :=
  instanceLaw.map (reachableHistoryOf strategy oracle t)

end ReachableHistories

/-- Data certifying that the transcript partition generated by an adaptive
strategy has the hard-family conditional node and deficit drop required at
each history. -/
structure CertifiedStrategy
    {Query Answer Output Omega : Type} [Fintype Omega]
    (d T : ℕ) (instanceLaw : FinitePMF Omega)
    (strategy : DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer)
    (deficit : ℕ → Omega → ℝ) where
  node : ∀ t : Fin T, ReachableHistory strategy oracle t.val → HistoryNode d
  drop_identity : ∀ (t : Fin T) (history : ReachableHistory strategy oracle t.val),
    (reachableHistoryLaw strategy oracle instanceLaw t.val).weight history *
        (node t history).localDrop =
      instanceLaw.fiberContribution
        (reachableHistoryOf strategy oracle t.val)
        (fun omega => deficit t.val omega - deficit (t.val + 1) omega)
        history

namespace CertifiedStrategy

variable {Query Answer Output Omega : Type} [Fintype Omega]
    {d T : ℕ} {instanceLaw : FinitePMF Omega}
    {strategy : DeterministicAdaptiveStrategy Query Answer Output}
    {oracle : Omega → Query → Answer}
    {deficit : ℕ → Omega → ℝ}

/-- The transcript level induced by the raw strategy at time `t`. -/
noncomputable def level
    (certificate : CertifiedStrategy d T instanceLaw strategy oracle deficit)
    (t : Fin T) : TranscriptLevel d where
  History := ReachableHistory strategy oracle t.val
  fintypeHistory := reachableHistoryFintype strategy oracle t.val
  historyLaw := reachableHistoryLaw strategy oracle instanceLaw t.val
  node := certificate.node t

/-- Averaging the certified conditional drops over reachable histories equals
the prior expectation of the pointwise deficit difference. -/
theorem meanDrop_eq
    (certificate : CertifiedStrategy d T instanceLaw strategy oracle deficit)
    (t : Fin T) :
    (certificate.level t).meanDrop =
      instanceLaw.expect
        (fun omega => deficit t.val omega - deficit (t.val + 1) omega) := by
  classical
  unfold TranscriptLevel.meanDrop FinitePMF.expect level
  rw [show
      (∑ history : ReachableHistory strategy oracle t.val,
        (reachableHistoryLaw strategy oracle instanceLaw t.val).weight history *
          (certificate.node t history).localDrop) =
      ∑ history : ReachableHistory strategy oracle t.val,
        instanceLaw.fiberContribution
          (reachableHistoryOf strategy oracle t.val)
          (fun omega => deficit t.val omega - deficit (t.val + 1) omega)
          history by
    apply Finset.sum_congr rfl
    intro history _
    exact certificate.drop_identity t history]
  exact instanceLaw.sum_fiberContribution
    (reachableHistoryOf strategy oracle t.val)
    (fun omega => deficit t.val omega - deficit (t.val + 1) omega)

/-- Construct the abstract adaptive transcript process directly from a
transcript-to-query strategy and its per-history hard-family certificate. -/
noncomputable def toAdaptiveProcess
    (certificate : CertifiedStrategy d T instanceLaw strategy oracle deficit) :
    AdaptiveTranscriptProcess d T where
  level := certificate.level
  meanDeficit t := instanceLaw.expect (deficit t)
  step_eq t := by
    rw [certificate.meanDrop_eq]
    exact (instanceLaw.expect_sub (deficit t.val) (deficit (t.val + 1))).symm

@[simp] theorem toAdaptiveProcess_meanDeficit
    (certificate : CertifiedStrategy d T instanceLaw strategy oracle deficit)
    (t : ℕ) :
    certificate.toAdaptiveProcess.meanDeficit t = instanceLaw.expect (deficit t) :=
  rfl

end CertifiedStrategy

/-- Finite-seed lower bound stated for actual transcript-to-query strategies.
The only hard-family input still supplied as a certificate is the exact
conditional-node/drop identity at each reachable transcript. -/
theorem finiteSeed_strategy_distributional_lower_bound
    {Seed Omega Query Answer Output : Type}
    [Fintype Seed] [Fintype Omega]
    (seedLaw : FinitePMF Seed) (instanceLaw : FinitePMF Omega)
    (strategy : Seed → DeterministicAdaptiveStrategy Query Answer Output)
    (oracle : Omega → Query → Answer)
    (loss : Omega → Output → ℝ)
    (deficit : Seed → ℕ → Omega → ℝ)
    (T : ℕ)
    (certificate : ∀ seed,
      CertifiedStrategy (proofDimension T) T instanceLaw
        (strategy seed) oracle (deficit seed))
    {rho : ℝ}
    (hrhoIoo : rho ∈ Set.Ioo (0 : ℝ) 1)
    (hrhoEq :
      rhoLHS (hardWeight (proofDimension T))
          (hardTopWeight (proofDimension T)) rho =
        hardC (proofDimension T) ^ 2)
    (hzero : ∀ seed,
      instanceLaw.expect (deficit seed 0) =
        initialDeficit (proofDimension T))
    (hloss : ∀ seed omega,
      rho ^ 2 * hardC (proofDimension T) ^ 2 * deficit seed T omega ^ 2 /
          (48 * (proofDimension T : ℝ) ^ 2) ≤
        loss omega ((strategy seed).run oracle omega T)) :
    hardC (proofDimension T) ^ 2 /
        (768 * (proofDimension T : ℝ) ^ 2) ≤
      (seedLaw.product instanceLaw).expect
        (fun pair => loss pair.2 ((strategy pair.1).run oracle pair.2 T)) := by
  let process : Seed → AdaptiveTranscriptProcess (proofDimension T) T :=
    fun seed => (certificate seed).toAdaptiveProcess
  apply finiteSeed_adaptive_distributional_lower_bound seedLaw instanceLaw
    (fun seed omega => deficit seed T omega)
    (fun seed omega => loss omega ((strategy seed).run oracle omega T))
    T process hrhoIoo hrhoEq
  · intro seed
    exact hzero seed
  · intro seed
    rfl
  · exact hloss

end Lemmata.DistributionalLowerBounds.Core.Distributional
