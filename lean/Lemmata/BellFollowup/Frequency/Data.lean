def separationWeight (m : ℕ) (i : Fin ((m+1)/2)) : ℤ :=
  (separationData m).2[i.val]?.getD 0

abbrev ExactGap (m : ℕ) :=
  (∀ i, -(separationData m).1 ≤ dot (separationWeight m) (reducedCandidate m i) ∧
    dot (separationWeight m) (reducedCandidate m i) ≤ (separationData m).1) ∧
    (separationData m).1 < dot (separationWeight m) (reducedShifted m)

theorem reduced_outside (m : ℕ) (hg : ExactGap m) :
    realProfile (reducedShifted m) ∉ signedHull (reducedCandidate m) :=
  outside_signedHull_of_score _ _ _ _ hg.1 hg.2


