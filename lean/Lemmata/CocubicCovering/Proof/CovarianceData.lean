def coordinateColumns (direction : Fin 2) (generator : Fin 4) (i : Fin 24) : Nat :=
  ((columnData[4 * direction.val + generator.val]?.getD [])[i.val]?).getD 0

def coordinateRows (direction : Fin 2) (generator : Fin 4) (i : Fin 24) : Nat :=
  ((coordinateRowData[4 * direction.val + generator.val]?.getD [])[i.val]?).getD 0

def inverseCoordinateRows (direction : Fin 2) (generator : Fin 4) (i : Fin 24) : Nat :=
  ((inverseRowData[4 * direction.val + generator.val]?.getD [])[i.val]?).getD 0

def parameterRows (direction : Fin 2) (generator : Fin 4) (i : Fin 127) : Nat :=
  ((parameterRowData[4 * direction.val + generator.val]?.getD [])[i.val]?).getD 0

def equations_encoded_decision (i j : Fin 24) : Decidable (encode parameterMasks
      (CoveringMatrix.equation (CoveringMatrix.multiplier i) (CoveringMatrix.multiplier j)) =
      some (matrixRows i j)) :=
  inferInstance

@[noinline, never_extract]
def equations_encoded_check (i j : Fin 24) : Bool :=
  @decide (encode parameterMasks
      (CoveringMatrix.equation (CoveringMatrix.multiplier i) (CoveringMatrix.multiplier j)) =
      some (matrixRows i j)) (equations_encoded_decision i j)

theorem equations_encoded_check_sound (i j : Fin 24) (computed : equations_encoded_check i j = true) :
    encode parameterMasks
      (CoveringMatrix.equation (CoveringMatrix.multiplier i) (CoveringMatrix.multiplier j)) =
      some (matrixRows i j) := by
  unfold equations_encoded_check at computed
  exact @of_decide_eq_true (encode parameterMasks
      (CoveringMatrix.equation (CoveringMatrix.multiplier i) (CoveringMatrix.multiplier j)) =
      some (matrixRows i j)) (equations_encoded_decision i j) computed

theorem equations_encoded :
    ∀ i j : Fin 24, encode parameterMasks
      (CoveringMatrix.equation (CoveringMatrix.multiplier i) (CoveringMatrix.multiplier j)) =
      some (matrixRows i j) := by
  have computed : ∀ (i j : Fin 24), equations_encoded_check i j = true := by native_decide
  intro i j
  exact equations_encoded_check_sound i j (computed i j)

def coefficientIdentities_decision (direction : Fin 2) (generator : Fin 4) : Decidable (∀ i j : Fin 24, composeRow (matrixRows i j) (parameterRows direction generator) =
      congruenceRow matrixRows (coordinateColumns direction generator i)
        (coordinateColumns direction generator j)) :=
  inferInstance

@[noinline, never_extract]
def coefficientIdentities_check (direction : Fin 2) (generator : Fin 4) : Bool :=
  @decide (∀ i j : Fin 24, composeRow (matrixRows i j) (parameterRows direction generator) =
      congruenceRow matrixRows (coordinateColumns direction generator i)
        (coordinateColumns direction generator j)) (coefficientIdentities_decision direction generator)

theorem coefficientIdentities_check_sound (direction : Fin 2) (generator : Fin 4) (computed : coefficientIdentities_check direction generator = true) :
    ∀ i j : Fin 24, composeRow (matrixRows i j) (parameterRows direction generator) =
      congruenceRow matrixRows (coordinateColumns direction generator i)
        (coordinateColumns direction generator j) := by
  unfold coefficientIdentities_check at computed
  exact @of_decide_eq_true (∀ i j : Fin 24, composeRow (matrixRows i j) (parameterRows direction generator) =
      congruenceRow matrixRows (coordinateColumns direction generator i)
        (coordinateColumns direction generator j)) (coefficientIdentities_decision direction generator) computed

theorem coefficientIdentities (direction : Fin 2) (generator : Fin 4) :
    ∀ i j : Fin 24, composeRow (matrixRows i j) (parameterRows direction generator) =
      congruenceRow matrixRows (coordinateColumns direction generator i)
        (coordinateColumns direction generator j) := by
  have computed : ∀ (direction : Fin 2) (generator : Fin 4), coefficientIdentities_check direction generator = true := by native_decide
  exact coefficientIdentities_check_sound direction generator (computed direction generator)

def coordinateTranspose_decision (direction : Fin 2) (generator : Fin 4) : Decidable (∀ i j : Fin 24, (coordinateRows direction generator i).testBit j.val =
      (coordinateColumns direction generator j).testBit i.val) :=
  inferInstance

@[noinline, never_extract]
def coordinateTranspose_check (direction : Fin 2) (generator : Fin 4) : Bool :=
  @decide (∀ i j : Fin 24, (coordinateRows direction generator i).testBit j.val =
      (coordinateColumns direction generator j).testBit i.val) (coordinateTranspose_decision direction generator)

theorem coordinateTranspose_check_sound (direction : Fin 2) (generator : Fin 4) (computed : coordinateTranspose_check direction generator = true) :
    ∀ i j : Fin 24, (coordinateRows direction generator i).testBit j.val =
      (coordinateColumns direction generator j).testBit i.val := by
  unfold coordinateTranspose_check at computed
  exact @of_decide_eq_true (∀ i j : Fin 24, (coordinateRows direction generator i).testBit j.val =
      (coordinateColumns direction generator j).testBit i.val) (coordinateTranspose_decision direction generator) computed

theorem coordinateTranspose (direction : Fin 2) (generator : Fin 4) :
    ∀ i j : Fin 24, (coordinateRows direction generator i).testBit j.val =
      (coordinateColumns direction generator j).testBit i.val := by
  have computed : ∀ (direction : Fin 2) (generator : Fin 4), coordinateTranspose_check direction generator = true := by native_decide
  exact coordinateTranspose_check_sound direction generator (computed direction generator)

def inverseRowIdentities_decision (direction : Fin 2) (generator : Fin 4) : Decidable (∀ i : Fin 24,
      composeRow (inverseCoordinateRows direction generator i)
        (coordinateRows direction generator) = 2 ^ i.val ∧
      composeRow (coordinateRows direction generator i)
        (inverseCoordinateRows direction generator) = 2 ^ i.val) :=
  inferInstance

@[noinline, never_extract]
def inverseRowIdentities_check (direction : Fin 2) (generator : Fin 4) : Bool :=
  @decide (∀ i : Fin 24,
      composeRow (inverseCoordinateRows direction generator i)
        (coordinateRows direction generator) = 2 ^ i.val ∧
      composeRow (coordinateRows direction generator i)
        (inverseCoordinateRows direction generator) = 2 ^ i.val) (inverseRowIdentities_decision direction generator)

theorem inverseRowIdentities_check_sound (direction : Fin 2) (generator : Fin 4) (computed : inverseRowIdentities_check direction generator = true) :
    ∀ i : Fin 24,
      composeRow (inverseCoordinateRows direction generator i)
        (coordinateRows direction generator) = 2 ^ i.val ∧
      composeRow (coordinateRows direction generator i)
        (inverseCoordinateRows direction generator) = 2 ^ i.val := by
  unfold inverseRowIdentities_check at computed
  exact @of_decide_eq_true (∀ i : Fin 24,
      composeRow (inverseCoordinateRows direction generator i)
        (coordinateRows direction generator) = 2 ^ i.val ∧
      composeRow (coordinateRows direction generator i)
        (inverseCoordinateRows direction generator) = 2 ^ i.val) (inverseRowIdentities_decision direction generator) computed

theorem inverseRowIdentities (direction : Fin 2) (generator : Fin 4) :
    ∀ i : Fin 24,
      composeRow (inverseCoordinateRows direction generator i)
        (coordinateRows direction generator) = 2 ^ i.val ∧
      composeRow (coordinateRows direction generator i)
        (inverseCoordinateRows direction generator) = 2 ^ i.val := by
  have computed : ∀ (direction : Fin 2) (generator : Fin 4), inverseRowIdentities_check direction generator = true := by native_decide
  exact inverseRowIdentities_check_sound direction generator (computed direction generator)

theorem coordinateLeftInverse (direction : Fin 2) (generator : Fin 4) :
    ∀ i : Fin 24, rowMap (inverseCoordinateRows direction generator)
      (rowMap (coordinateRows direction generator) (Pi.single i 1)) = Pi.single i 1 := by
  intro i
  funext j
  change evalRow (inverseCoordinateRows direction generator j)
    (rowMap (coordinateRows direction generator) (Pi.single i 1)) = (Pi.single i 1 : Vector 24) j
  rw [← evalRow_composeRow, (inverseRowIdentities direction generator j).1, evalRow_two_pow]

theorem coordinateRightInverse (direction : Fin 2) (generator : Fin 4) :
    ∀ i : Fin 24, rowMap (coordinateRows direction generator)
      (rowMap (inverseCoordinateRows direction generator) (Pi.single i 1)) = Pi.single i 1 := by
  intro i
  funext j
  change evalRow (coordinateRows direction generator j)
    (rowMap (inverseCoordinateRows direction generator) (Pi.single i 1)) = (Pi.single i 1 : Vector 24) j
  rw [← evalRow_composeRow, (inverseRowIdentities direction generator j).2, evalRow_two_pow]

def coordinateEquiv (direction : Fin 2) (generator : Fin 4) : Vector 24 ≃ₗ[Field] Vector 24 :=
  equivOfRows (coordinateRows direction generator) (inverseCoordinateRows direction generator)
    (coordinateLeftInverse direction generator) (coordinateRightInverse direction generator)

theorem coordinateEquiv_toLinearMap (direction : Fin 2) (generator : Fin 4) :
    (coordinateEquiv direction generator).toLinearMap =
      (columnMatrix (coordinateColumns direction generator)).toLin' :=
  (columnMatrix_toLin_eq_rowMap _ _ (coordinateTranspose direction generator)).symm

theorem matrix_equations (assignment : Nat → Field) :
    (fun i j : Fin 24 => evalField assignment
      (CoveringMatrix.equation (CoveringMatrix.multiplier i) (CoveringMatrix.multiplier j))) =
      coefficientMatrix matrixRows (pointedVector parameterMasks assignment) := by
  funext i j
  exact encode_sound parameterMasks _ _ (equations_encoded i j) assignment

theorem matrix_covariance (direction : Fin 2) (generator : Fin 4) (v : Vector 127) :
    coefficientMatrix matrixRows (rowMap (parameterRows direction generator) v) =
      (columnMatrix (coordinateColumns direction generator)).transpose *
        (coefficientMatrix matrixRows v * columnMatrix (coordinateColumns direction generator)) :=
  covariance_of_rows _ _ _ (coefficientIdentities direction generator) v

theorem rank_covariance (direction : Fin 2) (generator : Fin 4) (v : Vector 127) :
    Module.finrank Field (LinearMap.range (Matrix.toBilin'
      (coefficientMatrix matrixRows (rowMap (parameterRows direction generator) v)))) =
    Module.finrank Field (LinearMap.range (Matrix.toBilin' (coefficientMatrix matrixRows v))) :=
  rank_covariance_of_rows _ _ _ (coefficientIdentities direction generator)
    (coordinateEquiv direction generator) (coordinateEquiv_toLinearMap direction generator) v

