def multiplier (i : Fin 27) : Polynomial := multiplierData[i.val]?.getD []

def parameterMasks (i : Fin 126) : Nat := parameterLabelData[i.val]?.getD 0

def matrixRows (i j : Fin 27) : Nat := ((matrixRowData[i.val]?.getD [])[j.val]?).getD 0

def cubic : List Monomial := CoveringMatrix.cubic ++ [{6, 7, 8}]

def pairEquation (left right : Monomial) : Polynomial :=
  add (constantPolynomial cubic (left ∪ right))
    (if (left ∪ right).card = 4 then
      [{CoveringMatrix.parameterIndex (CoveringMatrix.ambient \ (left ∪ right))}] else [])

def rowEquation (left : Monomial) (right : Polynomial) : Polynomial :=
  right.foldr (fun term rest => add (pairEquation left term) rest) []

def equation (left right : Polynomial) : Polynomial :=
  left.foldr (fun term rest => add (rowEquation term right) rest) []

theorem evalField_pairEquation (assignment : ℕ → Field) (left right : Monomial) :
    evalField assignment (pairEquation left right) = constantCount cubic (left ∪ right) +
      if (left ∪ right).card = 4 then
        assignment (CoveringMatrix.parameterIndex (CoveringMatrix.ambient \ (left ∪ right)))
      else 0 := by
  unfold pairEquation
  rw [evalField_add, evalField_constantPolynomial]
  by_cases h : (left ∪ right).card = 4 <;>
    simp [h, evalField, evalMonomialField]

theorem pair_moment (p : ANF 9) (hp : DegreeLE p 5) (left right : Monomial)
    (hleft : ∀ v ∈ left, v < 9) (hright : ∀ v ∈ right, v < 9)
    (hdleft : left.card ≤ 2) (hdright : right.card ≤ 2) :
    (∑ x : Vector 9,
      evalMonomialField (CoveringEmbedding.extendAssignment x) left *
        evalMonomialField (CoveringEmbedding.extendAssignment x) right *
          (Covering.eval form9 + Covering.eval p) x) =
      evalField (parameterCoefficients p) (pairEquation left right) := by
  have hs : ∀ v ∈ left ∪ right, v < 9 := by
    intro v hv
    exact (Finset.mem_union.mp hv).elim (hleft v) (hright v)
  have hc : (left ∪ right).card ≤ 4 := by
    have hu := Finset.card_union_le left right
    omega
  have hfc : (finiteMonomial 9 (left ∪ right)).card ≤ 4 :=
    (finiteMonomial_card_le 9 _).trans hc
  simp_rw [CoveringPairing.evalMonomialField_at left hleft,
    CoveringPairing.evalMonomialField_at right hright,
    ← monomial_union, ← CoveringPairing.finiteMonomial_union, Pi.add_apply, mul_add]
  rw [Finset.sum_add_distrib, form9_monomial_moment _ hs,
    lower_degree_moment (by decide) p hp _ hfc, finiteMonomial_card _ hs,
    evalField_pairEquation, parameterCoefficients_index, finiteMonomial_complement]
  rfl

private theorem row_moment_of_pair (assignment : ℕ → Field) (g : BooleanFunction 9)
    (left : Monomial) (right : Polynomial)
    (hpairs : ∀ term ∈ right,
      (∑ x : Vector 9, evalMonomialField (CoveringEmbedding.extendAssignment x) left *
        evalMonomialField (CoveringEmbedding.extendAssignment x) term * g x) =
          evalField assignment (pairEquation left term)) :
    (∑ x : Vector 9, evalMonomialField (CoveringEmbedding.extendAssignment x) left *
      evalField (CoveringEmbedding.extendAssignment x) right * g x) =
        evalField assignment (rowEquation left right) := by
  induction right with
  | nil => simp [rowEquation, evalField]
  | cons term rest ih =>
      have hi := ih (fun t ht => hpairs t (by simp [ht]))
      change (∑ x : Vector 9, evalMonomialField (CoveringEmbedding.extendAssignment x) left *
        (evalMonomialField (CoveringEmbedding.extendAssignment x) term +
          evalField (CoveringEmbedding.extendAssignment x) rest) * g x) =
            evalField assignment (add (pairEquation left term) (rowEquation left rest))
      simp_rw [mul_add, add_mul]
      rw [Finset.sum_add_distrib, evalField_add, hpairs term (by simp), hi]

theorem equation_moment_of_pair (assignment : ℕ → Field) (g : BooleanFunction 9)
    (left right : Polynomial)
    (hpairs : ∀ first ∈ left, ∀ second ∈ right,
      (∑ x : Vector 9, evalMonomialField (CoveringEmbedding.extendAssignment x) first *
        evalMonomialField (CoveringEmbedding.extendAssignment x) second * g x) =
          evalField assignment (pairEquation first second)) :
    (∑ x : Vector 9, evalField (CoveringEmbedding.extendAssignment x) left *
      evalField (CoveringEmbedding.extendAssignment x) right * g x) =
        evalField assignment (equation left right) := by
  induction left with
  | nil => simp [equation, evalField]
  | cons term rest ih =>
      have hi := ih (fun t ht => hpairs t (by simp [ht]))
      change (∑ x : Vector 9,
        (evalMonomialField (CoveringEmbedding.extendAssignment x) term +
          evalField (CoveringEmbedding.extendAssignment x) rest) *
            evalField (CoveringEmbedding.extendAssignment x) right * g x) =
              evalField assignment (add (rowEquation term right) (equation rest right))
      simp_rw [add_mul]
      rw [Finset.sum_add_distrib, evalField_add,
        row_moment_of_pair assignment g term right (hpairs term (by simp)), hi]

def multiplier_bounded_decision (i : Fin 27) : Decidable (Bounded 9 (multiplier i)) :=
  (by unfold Bounded; infer_instance)

@[noinline, never_extract]
def multiplier_bounded_check (i : Fin 27) : Bool :=
  @decide (Bounded 9 (multiplier i)) (multiplier_bounded_decision i)

theorem multiplier_bounded_check_sound (i : Fin 27) (computed : multiplier_bounded_check i = true) :
    Bounded 9 (multiplier i) := by
  unfold multiplier_bounded_check at computed
  exact @of_decide_eq_true (Bounded 9 (multiplier i)) (multiplier_bounded_decision i) computed

theorem multiplier_bounded (i : Fin 27) : Bounded 9 (multiplier i) := by
  have computed : ∀ (i : Fin 27), multiplier_bounded_check i = true := by native_decide
  exact multiplier_bounded_check_sound i (computed i)

def multiplier_degree_decision (i : Fin 27) : Decidable (∀ term ∈ multiplier i, term.card ≤ 2) :=
  inferInstance

@[noinline, never_extract]
def multiplier_degree_check (i : Fin 27) : Bool :=
  @decide (∀ term ∈ multiplier i, term.card ≤ 2) (multiplier_degree_decision i)

theorem multiplier_degree_check_sound (i : Fin 27) (computed : multiplier_degree_check i = true) :
    ∀ term ∈ multiplier i, term.card ≤ 2 := by
  unfold multiplier_degree_check at computed
  exact @of_decide_eq_true (∀ term ∈ multiplier i, term.card ≤ 2) (multiplier_degree_decision i) computed

theorem multiplier_degree (i : Fin 27) : ∀ term ∈ multiplier i, term.card ≤ 2 := by
  have computed : ∀ (i : Fin 27), multiplier_degree_check i = true := by native_decide
  exact multiplier_degree_check_sound i (computed i)

def multiplier_product_bounded_decision (i : Fin 27) : Decidable (Bounded 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9)) :=
  (by unfold Bounded; infer_instance)

@[noinline, never_extract]
def multiplier_product_bounded_check (i : Fin 27) : Bool :=
  @decide (Bounded 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9)) (multiplier_product_bounded_decision i)

theorem multiplier_product_bounded_check_sound (i : Fin 27) (computed : multiplier_product_bounded_check i = true) :
    Bounded 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9) := by
  unfold multiplier_product_bounded_check at computed
  exact @of_decide_eq_true (Bounded 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9)) (multiplier_product_bounded_decision i) computed

theorem multiplier_product_bounded (i : Fin 27) :
    Bounded 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9) := by
  have computed : ∀ (i : Fin 27), multiplier_product_bounded_check i = true := by native_decide
  exact multiplier_product_bounded_check_sound i (computed i)

def multiplier_product_degree_decision (i : Fin 27) : Decidable (∀ term ∈ multiply (multiplier i) CoveringEmbedding.sparseForm9, term.card ≤ 7) :=
  inferInstance

@[noinline, never_extract]
def multiplier_product_degree_check (i : Fin 27) : Bool :=
  @decide (∀ term ∈ multiply (multiplier i) CoveringEmbedding.sparseForm9, term.card ≤ 7) (multiplier_product_degree_decision i)

theorem multiplier_product_degree_check_sound (i : Fin 27) (computed : multiplier_product_degree_check i = true) :
    ∀ term ∈ multiply (multiplier i) CoveringEmbedding.sparseForm9, term.card ≤ 7 := by
  unfold multiplier_product_degree_check at computed
  exact @of_decide_eq_true (∀ term ∈ multiply (multiplier i) CoveringEmbedding.sparseForm9, term.card ≤ 7) (multiplier_product_degree_decision i) computed

theorem multiplier_product_degree (i : Fin 27) :
    ∀ term ∈ multiply (multiplier i) CoveringEmbedding.sparseForm9, term.card ≤ 7 := by
  have computed : ∀ (i : Fin 27), multiplier_product_degree_check i = true := by native_decide
  exact multiplier_product_degree_check_sound i (computed i)

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2000000 in
def equations_encoded_decision (i j : Fin 27) : Decidable (encode parameterMasks (equation (multiplier i) (multiplier j)) = some (matrixRows i j)) :=
  inferInstance

@[noinline, never_extract]
def equations_encoded_check (i j : Fin 27) : Bool :=
  @decide (encode parameterMasks (equation (multiplier i) (multiplier j)) = some (matrixRows i j)) (equations_encoded_decision i j)

theorem equations_encoded_check_sound (i j : Fin 27) (computed : equations_encoded_check i j = true) :
    encode parameterMasks (equation (multiplier i) (multiplier j)) = some (matrixRows i j) := by
  unfold equations_encoded_check at computed
  exact @of_decide_eq_true (encode parameterMasks (equation (multiplier i) (multiplier j)) = some (matrixRows i j)) (equations_encoded_decision i j) computed

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2000000 in
theorem equations_encoded : ∀ i j : Fin 27,
    encode parameterMasks (equation (multiplier i) (multiplier j)) = some (matrixRows i j) := by
  have computed : ∀ (i j : Fin 27), equations_encoded_check i j = true := by native_decide
  intro i j
  exact equations_encoded_check_sound i j (computed i j)

def multiplierFunction (i : Fin 27) : BooleanFunction 9 := Covering.eval (decode 9 (multiplier i))

def multiplierLinear : Vector 27 →ₗ[Field] BooleanFunction 9 where
  toFun a := ∑ i, a i • multiplierFunction i
  map_add' a b := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' a b := by simp [Finset.smul_sum, smul_smul]

theorem multiplier_mem (i : Fin 27) : multiplierFunction i ∈ reedMuller 9 2 :=
  decode_mem_reedMuller _ _ _ (multiplier_degree i)

theorem multiplier_product_mem (i : Fin 27) :
    multiplierFunction i * Covering.eval form9 ∈ reedMuller 9 7 := by
  have heq : Covering.eval (decode 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9)) =
      multiplierFunction i * Covering.eval form9 := by
    funext x
    change Covering.eval (decode 9 (multiply (multiplier i) CoveringEmbedding.sparseForm9)) x =
      Covering.eval (decode 9 (multiplier i)) x * Covering.eval form9 x
    rw [CoveringEmbedding.eval_decode_at _ (multiplier_product_bounded i), evalField_multiply,
      ← CoveringEmbedding.eval_decode_at _ (multiplier_bounded i),
      ← CoveringEmbedding.eval_decode_at _ CoveringEmbedding.sparseForm9_bounded,
      CoveringEmbedding.decode_sparseForm9]
  rw [← heq]
  exact decode_mem_reedMuller _ _ _ (multiplier_product_degree i)

theorem multiplierLinear_mem (a : Vector 27) : multiplierLinear a ∈ reedMuller 9 2 := by
  change (∑ i : Fin 27, a i • multiplierFunction i) ∈ reedMuller 9 2
  apply (reedMuller 9 2).sum_mem
  intro i hi
  exact (reedMuller 9 2).smul_mem (a i) (multiplier_mem i)

theorem multiplierLinear_products (a : Vector 27) :
    multiplierLinear a * Covering.eval form9 ∈ reedMuller 9 7 := by
  have heq : multiplierLinear a * Covering.eval form9 =
      ∑ i : Fin 27, a i • (multiplierFunction i * Covering.eval form9) := by
    funext x
    simp [multiplierLinear, Finset.sum_mul, mul_assoc]
  rw [heq]
  apply (reedMuller 9 7).sum_mem
  intro i hi
  exact (reedMuller 9 7).smul_mem (a i) (multiplier_product_mem i)

theorem multiplierLinear_basis (i : Fin 27) :
    multiplierLinear (Pi.single i 1) = multiplierFunction i := by
  simp [multiplierLinear, Pi.single_apply]

theorem coordinate_gram (p : ANF 9) (hp : DegreeLE p 5) (i j : Fin 27) :
    supportGram (Covering.eval form9 + Covering.eval p) multiplierLinear
      (Pi.single i 1) (Pi.single j 1) =
        evalField (parameterCoefficients p) (equation (multiplier i) (multiplier j)) := by
  rw [supportGram_apply, multiplierLinear_basis, multiplierLinear_basis]
  change (∑ x : Vector 9, Covering.eval (decode 9 (multiplier i)) x *
    Covering.eval (decode 9 (multiplier j)) x * (Covering.eval form9 + Covering.eval p) x) = _
  simp_rw [CoveringEmbedding.eval_decode_at _ (multiplier_bounded i),
    CoveringEmbedding.eval_decode_at _ (multiplier_bounded j)]
  apply equation_moment_of_pair
  intro left hleft right hright
  exact pair_moment p hp left right (multiplier_bounded i left hleft)
    (multiplier_bounded j right hright) (multiplier_degree i left hleft)
    (multiplier_degree j right hright)

theorem exists_pointed_realization (h : BooleanFunction 9) (hh : h ∈ reedMuller 9 5) :
    ∃ v : Vector 127, v (Fin.last 126) = 1 ∧
      supportGram (Covering.eval form9 + h) multiplierLinear =
        Matrix.toBilin' (coefficientMatrix matrixRows v) := by
  obtain ⟨p, hp, rfl⟩ := mem_reedMuller_iff.mp hh
  let v := pointedVector parameterMasks (parameterCoefficients p)
  refine ⟨v, ?_, ?_⟩
  · change Fin.lastCases (motive := fun _ : Fin 127 => Field) (1 : Field)
      (fun i : Fin 126 => parameterCoefficients p (parameterMasks i)) (Fin.last 126) = 1
    rw [Fin.lastCases_last]
  · apply (Pi.basisFun Field (Fin 27)).ext
    intro i
    apply (Pi.basisFun Field (Fin 27)).ext
    intro j
    have he := encode_sound parameterMasks (equation (multiplier i) (multiplier j))
      (matrixRows i j) (equations_encoded i j) (parameterCoefficients p)
    simpa only [Pi.basisFun_apply, Matrix.toBilin'_single, coefficientMatrix, v] using
      (coordinate_gram p hp i j).trans he

theorem form9_packed_weight_reduction (h : BooleanFunction 9) (hh : h ∈ reedMuller 9 5) :
    ∃ v : Vector 127, v (Fin.last 126) = 1 ∧
      20 + Module.finrank Field
        (LinearMap.range (Matrix.toBilin' (coefficientMatrix matrixRows v))) ≤
          weight (Covering.eval form9 + h) := by
  obtain ⟨v, hv, hgram⟩ := exists_pointed_realization h hh
  refine ⟨v, hv, ?_⟩
  have hweight := weight_bound_of_correction (by decide) (Covering.eval form9) h
    form9_mem hh multiplierLinear multiplierLinear_mem multiplierLinear_products
  have hdim := form9_affine_dimension_lower h hh
  have hw : 20 + Module.finrank Field
      (LinearMap.range (supportGram (Covering.eval form9 + h) multiplierLinear)) ≤
        weight (Covering.eval form9 + h) := by omega
  rw [hgram] at hw
  exact hw

end Lemmata.CocubicCovering.CoveringLevelSix
